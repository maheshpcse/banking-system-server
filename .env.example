NODE_ENV=development
APP_ENV=development
PORT=3000
APP_PORT=3000
JWT_SECRET=change-me-in-production
# AES key material for PAN/CVV at rest (required in production). Falls back to JWT_SECRET for local demos.
CARD_ENCRYPTION_KEY=
# Optional separate HMAC key for card uniqueness hashes
CARD_HMAC_KEY=
MONGODB_URI=
USE_MEMORY_DB=true
CLIENT_ORIGIN=http://localhost:4200

# --- Email notifications (optional; no-op until EMAIL_ENABLED=true) ---
EMAIL_ENABLED=false
EMAIL_FROM=NovaBank <noreply@novabank.local>
# Prefer Resend HTTPS API:
RESEND_API_KEY=
# Or a custom webhook that accepts { from, to, subject, text }:
EMAIL_WEBHOOK_URL=
# Declared for operators who later add an SMTP SDK:
SMTP_URL=

# --- SMS notifications / Twilio OTP (optional; no-op until SMS_ENABLED=true) ---
# Phone OTP sign-in uses this channel. Until SMS is configured, OTP codes are
# still generated and logged to the API console (see delivered=false on
# /auth/otp/request). Production should enable Twilio:
#   1) Create a Twilio account and buy/verify a From number
#   2) Copy Account SID + Auth Token from the Twilio console
#   3) Set SMS_ENABLED=true and the three TWILIO_* values below
#   4) Restart the API; request a phone OTP and confirm delivery
# Local development tip: leave SMS_ENABLED=false and read the code from
# server logs (`[otp] phone → …`). Set NOTIFY_DEBUG=true to also log skipped
# SMS/email no-ops.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Log skipped channel attempts:
NOTIFY_DEBUG=false

# Public support inbox shown to blocked/deactivated users
SUPPORT_EMAIL=support@novabank.local
