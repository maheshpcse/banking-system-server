NODE_ENV=development
APP_ENV=development
PORT=3000
APP_PORT=3000
JWT_SECRET=change-me-in-production
# AES key material for PAN/CVV at rest (required in production). Falls back to JWT_SECRET for local demos.
CARD_ENCRYPTION_KEY=
# Optional separate HMAC key for card uniqueness hashes
CARD_HMAC_KEY=
MONGODB_URI=
USE_MEMORY_DB=true
CLIENT_ORIGIN=http://localhost:4200

# --- Email notifications (optional; no-op until EMAIL_ENABLED=true) ---
EMAIL_ENABLED=false
EMAIL_FROM=NovaBank <noreply@novabank.local>
# Prefer Resend HTTPS API:
RESEND_API_KEY=
# Or a custom webhook that accepts { from, to, subject, text }:
EMAIL_WEBHOOK_URL=
# Declared for operators who later add an SMTP SDK:
SMTP_URL=

# --- SMS notifications (optional; no-op until SMS_ENABLED=true) ---
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Log skipped channel attempts:
NOTIFY_DEBUG=false
